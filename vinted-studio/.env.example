# Fournisseur d'images : gemini (recommandé), openai, ou mock (test sans clé, renvoie la photo d'origine)
PROVIDER=gemini

# Clé Google AI Studio : https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-image

# Clé OpenAI (si PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-image-1

PORT=3000
# Nombre de photos générées en parallèle
CONCURRENCY=3
